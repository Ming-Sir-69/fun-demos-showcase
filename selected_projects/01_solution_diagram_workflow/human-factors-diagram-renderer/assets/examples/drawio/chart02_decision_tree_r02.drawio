<mxfile host="app.diagrams.net" modified="2026-06-22T00:25:30.000Z" version="24.7.17" type="device" pages="1"><diagram id="page_agent_ac5081501b" name="多 Agent 复合根因判断树"><mxGraphModel dx="1307" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="canvas_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#F8F6F0;" vertex="1" parent="1"><mxGeometry width="1600" height="980" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;多 Agent 复合根因判断树&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#4D4D4D&quot;&gt;最强业务逻辑 / Multi-Agent Composite Root Cause Decision Tree&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#1A1A1A;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry width="1160" height="50" as="geometry" x="220" y="22" /></mxCell><mxCell id="start" value="&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;22&quot; height=&quot;22&quot; style=&quot;vertical-align:middle;&quot;/&gt;&lt;br&gt;&lt;b&gt;异常发生：发现多个疑似诱因&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=16;fillColor=#D6E4F0;strokeColor=#2E5585;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="260" height="58" as="geometry" x="670" y="110" /></mxCell><mxCell id="a1" value="&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;22&quot; height=&quot;22&quot; style=&quot;vertical-align:middle;&quot;/&gt;&lt;br&gt;&lt;b&gt;SQE Agent 报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;来料参数异常&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=12;fillColor=#D6E4F0;strokeColor=#8BA5BD;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="230" height="62" as="geometry" x="500" y="222" /></mxCell><mxCell id="a2" value="&lt;img src=&quot;data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMUExQTFBIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBvbHlsaW5lIHBvaW50cz0iMjIgMTIgMTggMTIgMTUgMjEgOSAzIDYgMTIgMiAxMiIvPjwvc3ZnPg==&quot; width=&quot;22&quot; height=&quot;22&quot; style=&quot;vertical-align:middle;&quot;/&gt;&lt;br&gt;&lt;b&gt;PQE Agent 报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;制程温度偏移&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=12;fillColor=#D6E4F0;strokeColor=#8BA5BD;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="230" height="62" as="geometry" x="870" y="222" /></mxCell><mxCell id="q1" value="&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;22&quot; height=&quot;22&quot; style=&quot;vertical-align:middle;&quot;/&gt;&lt;br&gt;&lt;b&gt;主控 Agent 发起交叉验证&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;去除单一因素，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;不良是否单独复现？&lt;/font&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3E8D5;strokeColor=#D2C7B8;strokeWidth=1.5;fontColor=#2C3E50;fontSize=12;align=center;verticalAlign=middle;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;spacing=4;" vertex="1" parent="1"><mxGeometry width="330" height="120" as="geometry" x="635" y="338" /></mxCell><mxCell id="cA" value="&lt;b&gt;条件 A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;去除温度偏移&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;来料异常不再导致不良&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=50;fillColor=#FFFFFF;strokeColor=#DADDE0;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="220" height="50" as="geometry" x="280.5" y="568" /></mxCell><mxCell id="cB" value="&lt;b&gt;条件 B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;去除来料异常&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;温度偏移不再导致不良&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=50;fillColor=#FFFFFF;strokeColor=#DADDE0;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="220" height="50" as="geometry" x="553.5" y="568" /></mxCell><mxCell id="cC" value="&lt;b&gt;条件 C&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;去除任何一个&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;不良都会消失&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=50;fillColor=#FFFFFF;strokeColor=#DADDE0;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="220" height="50" as="geometry" x="826.5" y="568" /></mxCell><mxCell id="cD" value="&lt;b&gt;条件 D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;两个因素都去除&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;不良依然存在&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=50;fillColor=#FFFFFF;strokeColor=#DADDE0;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="220" height="50" as="geometry" x="1099.5" y="568" /></mxCell><mxCell id="r1" value="&lt;b&gt;制程温度是主根因&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;来料异常是诱发条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=12;fillColor=#DDE9DB;strokeColor=#9DB88E;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="245" height="72" as="geometry" x="268" y="672" /></mxCell><mxCell id="r2" value="&lt;b&gt;来料异常是主根因&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;制程温度是诱发条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=12;fillColor=#DDE9DB;strokeColor=#9DB88E;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="245" height="72" as="geometry" x="541" y="672" /></mxCell><mxCell id="r3" value="&lt;b&gt;两者均为独立根因&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;需并列写入 D4 报告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=12;fillColor=#DDE9DB;strokeColor=#9DB88E;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="245" height="72" as="geometry" x="814" y="672" /></mxCell><mxCell id="r4" value="&lt;b&gt;判定：现有假设全错&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;触发 Agent 重新调研&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Segoe UI, PingFang SC, Microsoft YaHei, Arial, sans-serif;align=center;verticalAlign=middle;spacing=6;arcSize=12;fillColor=#DDE9DB;strokeColor=#9DB88E;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1"><mxGeometry width="245" height="72" as="geometry" x="1087" y="672" /></mxCell><mxCell id="fi